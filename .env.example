# Copia este archivo como .env y reemplaza todos los valores change-me.
SECRET_KEY=change-me-use-at-least-50-random-characters
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com
FRONTEND_URL=https://example.com
POSTGRES_DB=smilemanager
POSTGRES_USER=smilemanager
POSTGRES_PASSWORD=change-me-database-password
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password-at-least-8-chars
AWS_STORAGE_BUCKET_NAME=smilemanager-media
AWS_S3_PUBLIC_ENDPOINT=https://media.example.com
APP_PORT=8000
FEATURE_AI_ENABLED=false
TRUST_PROXY_HTTPS_HEADER=true
EMAIL_HOST=smtp.example.com
# En Docker local, agrega estas variables a .local-ops.env.
# Cambia file por smtp solo cuando tengas configurado tu proveedor.
DEV_EMAIL_DELIVERY=file
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USER=
EMAIL_PASS=
DEFAULT_FROM_EMAIL=

# Neon CLI: neon deploy writes private values to .env.local (or existing .env).
# Keep SSL query parameters supplied by Neon. Runtime uses the pooled URL;
# manage.py migrate automatically selects the direct URL when provided.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.region.aws.neon.tech/neondb?sslmode=require

# Upstash REST client (server only; never use a VITE_ prefix).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Django uses the same database through its TLS Redis URL, not the REST token.
THROTTLE_REDIS_URL=
